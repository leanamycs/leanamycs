/.lake

# Blueprint build artifacts (regenerated by `leanblueprint pdf`/`web` and by CI)
/blueprint/web/
/blueprint/print/
/blueprint/lean_decls
/blueprint/src/*.paux

# Local-only scratch files (not part of the committed doc build)
/docbuild/
/home_page/_config_local.yml
/home_page/Gemfile.lock
/home_page/.jekyll-cache/
/home_page/_site/

# latexmk build byproducts for latex/rumor_push.tex (rumor_push.pdf IS committed)
/latex/*.aux
/latex/*.fdb_latexmk
/latex/*.fls
/latex/*.log
/latex/*.out
/latex/*.synctex.gz
